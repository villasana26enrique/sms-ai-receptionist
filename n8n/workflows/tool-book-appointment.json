{
  "id": "tCInZXEmBEsGlo9t",
  "name": "Tool: Book appointment",
  "description": "Agent tool: books the appointment in the database (validation, booking code, overlap constraint) and mirrors it as a Google Calendar event.",
  "active": false,
  "nodes": [
    {
      "id": "0ec9e9cd-412f-4b74-befb-4f20c959214a",
      "name": "When the agent books",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        96
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "date",
              "type": "string"
            },
            {
              "name": "time",
              "type": "string"
            },
            {
              "name": "full_name",
              "type": "string"
            },
            {
              "name": "service",
              "type": "string"
            },
            {
              "name": "phone",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "fff53617-c8e8-4bc3-ba24-3e12bd3d5246",
      "name": "Book in database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        96
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT dental_clinic.book_appointment($1, $2, $3, $4::date, $5::time) AS r;",
        "options": {
          "queryReplacement": "={{ [$json.phone, $json.full_name, $json.service, $json.date, $json.time] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "QugGwVrTwVGwNGBq",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "b5f2e306-925a-4752-b3b3-767c8dde4bbb",
      "name": "Booked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.r.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "123aa811-eab3-4ea2-9a40-b6d2d4c2cb1c",
      "name": "Create Google Calendar event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "__GOOGLE_CALENDAR_ID__",
          "cachedResultName": "Clinic calendar"
        },
        "start": "={{ $json.r.starts_at }}",
        "end": "={{ $json.r.ends_at }}",
        "additionalFields": {
          "summary": "={{ $json.r.service }} - {{ $json.r.patient }}",
          "description": "=Booking code: {{ $json.r.booking_code }}\nPatient: {{ $json.r.patient }}\nService: {{ $json.r.service }}\nPhone: +{{ $('When the agent books').item.json.phone }}\nBooked by the SMS assistant (the appointment lives in the database)."
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YuVyTsCz6Jv4vpYH",
          "name": "Google Calendar account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "6e25b038-c824-4f2a-9226-590d25e84f2e",
      "name": "Link event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT dental_clinic.set_google_event($1::int, NULLIF($2, ''));",
        "options": {
          "queryReplacement": "={{ [$('Book in database').item.json.r.appointment_id, $json.id || ''] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "QugGwVrTwVGwNGBq",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "8043b468-7b2e-4a54-91d8-6a723d6b676b",
      "name": "Result: booked",
      "type": "n8n-nodes-base.set",
