              "value": "={{ $('Book in database').item.json.r.time }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "={{ $('Book in database').item.json.r.message }}",
              "type": "string"
            }
          ]
        }
      }
