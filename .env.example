# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=receptionist
POSTGRES_HOST_PORT=5435

# n8n
N8N_VERSION=2.40.5
# Public base URL n8n should use for webhooks (your tunnel or server domain, with trailing slash).
# It must be the exact URL configured in Twilio: the request signature is computed over it.
N8N_WEBHOOK_URL=https://your-domain.example.com/
# Encrypts the credentials stored in n8n. Generate one (e.g. openssl rand -hex 24) and keep it safe:
# without it, saved credentials cannot be read.
N8N_ENCRYPTION_KEY=generate-a-long-random-string

N8N_HOST_PORT=5680

# ---- Used by scripts/setup-n8n.sh to create the n8n credentials ----
# Twilio Console > Account info. The Auth Token also verifies that incoming webhooks really come from Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Google AI Studio API key (Gemini)
GEMINI_API_KEY=your-gemini-api-key
# Google Cloud OAuth client (Web application) with the Google Calendar API enabled.
# Redirect URI: <n8n url>/rest/oauth2-credential/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Google Calendar used as the clinic's appointment view (Calendar settings > Integrate calendar > Calendar ID)
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Optional: clinic documents (aftercare, insurance, policies) from the RAG knowledge assistant
# (https://github.com/villasana26enrique/rag-knowledge-assistant). The key is created there with
# ./scripts/create-api-key.sh patient-assistant "SMS receptionist". Without them the agent says it cannot check.
# host.docker.internal = the machine running Docker (both stacks on one host); use the real URL on a server.
RAG_SEARCH_URL=http://host.docker.internal:5679/webhook/search
RAG_SEARCH_API_KEY=your-rag-search-api-key

# ngrok (only with: docker compose --profile tunnel up -d)
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-static-domain.ngrok-free.dev

# Optional: reuse existing Docker volumes instead of creating new ones
# POSTGRES_VOLUME=sms_ai_receptionist_postgres
# N8N_VOLUME=sms_ai_receptionist_n8n
